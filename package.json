{
  "name": "docstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test src/lib/auth/auth-options.test.ts src/lib/auth/google-identity.test.ts src/lib/auth/google-link-intent.test.ts src/lib/auth/google-link-action.test.ts src/lib/auth/google-link-request.test.ts src/lib/auth/google-connection-ui.test.tsx src/lib/auth/session-identity.test.ts src/lib/auth/identity-email.test.ts src/lib/auth/verification-tokens.test.ts src/lib/auth/email-provider.test.ts src/lib/auth/login-ui.test.tsx",
    "auth:inventory": "NODE_ENV=development node --env-file=.env.development.local --import tsx scripts/auth-inventory.ts",
    "auth:seed-identity-keys": "NODE_ENV=development node --env-file=.env.development.local --import tsx scripts/auth-seed-identity-keys.ts",
    "stripe:listen": "stripe listen --project-name docstack --forward-to localhost:3000/api/webhooks/stripe",
    "lint": "eslint",
    "test:auth:integration": "node --import tsx --test src/lib/auth/firestore-identity.integration.test.ts",
    "test:auth:emulator": "npx --yes firebase-tools emulators:exec --config firebase.auth-emulator.json --project demo-docstack-auth --only firestore \"npm run test:auth:integration\""
  },
  "dependencies": {
    "@auth/firebase-adapter": "2.11.3",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@t3-oss/env-nextjs": "^0.13.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-auth": "4.24.15",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.4",
    "shadcn": "^4.0.5",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "4.20.5",
    "typescript": "^5"
  }
}
