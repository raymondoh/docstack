# =========================================================================
# DocStack Project GitIgnore Configuration
# =========================================================================

# --- Dependencies ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js & Build Outputs ---
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# --- Environment & Secret Files ---
# Block all local and secret environment files
.env
.env.local
.env.development.local
.env.production.local
.env*.local

# EXCEPTION: Allow the example and base blueprints to be committed
!.env.example
!.env.production
!.env.development

# --- JSON Security Blanket ---
# Blocks generic JSON dumps while protecting critical project files
*.json
!package.json
!package-lock.json
!tsconfig.json
!components.json
!firebase.auth-emulator.json
!src/lib/auth/package.json

# --- Platforms & Tools ---
.vercel/

# --- System & Logs ---
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Miscellaneous ---
/coverage

# Local credentials
/secrets/