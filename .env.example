# =========================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES (.env.development.local)
# Loaded automatically by running: npm run dev
# =========================================================================

# --- App & Auth ---
ADMIN_EMAIL="xxx"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET="xxx"
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID="xxx"
GOOGLE_CLIENT_SECRET="xxx"

# --- Firebase Admin (Server) ---
# NOTE: If you create a separate Firebase dev project later, swap this JSON out.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.dev.json

# --- Firebase Client (Public) ---
NEXT_PUBLIC_FIREBASE_API_KEY="xxx"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="xxx"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="xxx"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="xxx"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="xxx"
NEXT_PUBLIC_FIREBASE_APP_ID="xxx"

# --- Stripe (SAFE TEST MODE) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="xxx"
STRIPE_SECRET_KEY="xxx"
STRIPE_WEBHOOK_SECRET="xxx"

# --- Algolia Search ---
NEXT_PUBLIC_ALGOLIA_APP_ID="xxx"
NEXT_PUBLIC_ALGOLIA_SEARCH_ONLY_KEY="xxx"
ALGOLIA_ADMIN_API_KEY="xxx"

# --- Email (Resend) ---
RESEND_API_KEY="xxx"
EMAIL_FROM="DocStack <hello@example.com>"
SUPPORT_EMAIL="xxx"
CONTACT_FORM_RECEIVER_EMAIL="xxx"
FULFILLMENT_RECONCILIATION_SECRET="replace-with-at-least-32-random-characters"

# --- SEO ---
NEXT_PUBLIC_SEO_INDEXABLE=false
